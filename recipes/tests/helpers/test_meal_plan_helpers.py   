"""
Tests for meal plan helper functions.
"""

from datetime import date
from django.test import TestCase
from django.contrib.auth import get_user_model

from recipes.models.meal_plan import MealPlan, MealSlot
from recipes.helpers.meal_plan_helpers import (
 get_monday,
 calculate_completion,
 create_meal_slots,
 reuse_prev_week,
)
from recipes.helpers.meal_plan_helpers import calculate_meals_logged

User = get_user_model()


class GetMondayHelperTests(TestCase):
 """ Tests for get_monday helper. """

 def test_returns_monday_for_midweek_date(self):
  test_date = date(2025, 11, 27)

  monday = get_monday(test_date)

  self.assertEqual(monday, date(2025, 11, 24))

 def test_returns_same_date_if_monday(self):
  test_date = date(2025, 11, 24)

  self.assertEqual(get_monday(test_date), test_date)


class CalculateCompletionHelperTests(TestCase):
 """ Tests for calculate_completion helper. """

 def setUp(self):
  self.user = User.objects.create_user(
   username="@helperuser",
   email="helper@example.com",
   password="Password123",
  )

  self.plan = MealPlan.objects.create(
   user=self.user,
   week_start=date(2025, 11, 24),
  )

 def test_returns_zero_when_no_slots_exist(self):
  completion = calculate_completion(self.plan)

  self.assertEqual(completion, 0)

 def test_returns_zero_when_slots_have_no_recipes(self):
  MealSlot.objects.create(
   meal_plan=self.plan,
   day="mon",
   meal_type="breakfast",
  )

  completion = calculate_completion(self.plan)

  self.assertEqual(completion, 0)

 def test_returns_full_completion(self):
  for meal in ["breakfast", "lunch", "dinner"]:
   MealSlot.objects.create(
    meal_plan=self.plan,
    day="mon",
    meal_type=meal,
    recipe_id=1,
   )

  completion = calculate_completion(self.plan)

  self.assertEqual(completion, 100)


class CreateMealSlotsHelperTests(TestCase):
 """ Tests for create_meal_slots helper. """

 def setUp(self):
  self.user = User.objects.create_user(
   username="@slotuser",
   email="slot@example.com",
   password="Password123",
  )

  self.plan = MealPlan.objects.create(
   user=self.user,
   week_start=date(2025, 11, 24),
  )

 def test_creates_28_meal_slots(self):
  create_meal_slots(self.plan)

  self.assertEqual(self.plan.entries.count(), 28)

 def test_create_meal_slots_is_not_idempotent(self):
  create_meal_slots(self.plan)

  with self.assertRaises(Exception):
   create_meal_slots(self.plan)


class ReusePrevWeekHelperTests(TestCase):
 """ Tests for reuse_prev_week helper. """

 def setUp(self):
  self.user = User.objects.create_user(
   username="@reuseuser",
   password="Password123",
  )

  self.prev_plan = MealPlan.objects.create(
   user=self.user,
   week_start=date(2025, 11, 17),
  )

  self.current_plan = MealPlan.objects.create(
   user=self.user,
   week_start=date(2025, 11, 24),
  )

  create_meal_slots(self.prev_plan)
  create_meal_slots(self.current_plan)

 def test_copies_meals_from_previous_week(self):
  slot = self.prev_plan.entries.filter(
   day="mon",
   meal_type="breakfast",
  ).first()

  slot.notes = "Test notes"
  slot.save()

  result = reuse_prev_week(self.current_plan)

  self.assertTrue(result)

  new_slot = self.current_plan.entries.filter(
   day="mon",
   meal_type="breakfast",
  ).first()

  self.assertEqual(new_slot.notes, "Test notes")

 def test_returns_false_when_no_previous_plan(self):
  new_plan = MealPlan.objects.create(
   user=self.user,
   week_start=date(2025, 12, 1),
  )

  self.assertFalse(reuse_prev_week(new_plan))


class CalculateMealsLoggedHelperTests(TestCase):
    """ Tests for calculate_meals_logged helper. """

    def setUp(self):
        self.user = User.objects.create_user(
            username="@loggeduser",
            password="Password123"
        )

        self.plan = MealPlan.objects.create(
            user=self.user,
            week_start=date(2025, 11, 24)
        )

        create_meal_slots(self.plan)

    def test_returns_zero_when_no_meals_logged(self):
        logged, total = calculate_meals_logged(self.plan)

        self.assertEqual(logged, 0)
        self.assertEqual(total, 21)

    def test_counts_only_breakfast_lunch_dinner(self):
        self.plan.entries.filter(
            day="mon",
            meal_type="breakfast"
        ).update(recipe_id=1)

        self.plan.entries.filter(
            day="mon",
            meal_type="snack"
        ).update(recipe_id=1)

        logged, total = calculate_meals_logged(self.plan)

        self.assertEqual(logged, 1)
